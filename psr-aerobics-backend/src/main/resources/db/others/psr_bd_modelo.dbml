// PSR Aeróbicos — Modelo de datos

Enum fuente_registro_enum {
  ADMIN
  AUTOREGISTRO
}

Enum tipo_documento_enum {
  CC
  TI
  CE
  PA
}

Enum metodo_checkin_enum {
  QR
  DOCUMENTO
  MANUAL
  PROPIO
}

Enum tipo_movimiento_enum {
  ABONO
  REEMBOLSO
}

Enum tabla_auditable_enum {
  ASISTENCIA
  MOVIMIENTO_CUENTA
  TARIFA
  CONFIGURACION_COLA
  PERSONA
  SESION
}

Enum rol_nombre_enum {
  ADMIN
  MIEMBRO
  PROFESOR
  RECEPCIONISTA
}

Table rol {
  id integer [pk, increment]
  nombre rol_nombre_enum [not null, unique]
}

Table persona {
  id integer [pk, increment]
  tipo_documento tipo_documento_enum [not null]
  numero_documento varchar(20) [not null, unique]
  nombre varchar(100) [not null]
  apellidos varchar(100) [not null]
  telefono varchar(20) [not null]
  fuente_registro fuente_registro_enum [not null]
  fecha_registro timestamptz [not null, default: `now()`]
  activo boolean [not null, default: true]

  Note: '''
    id 999999999 = persona sentinel ("Usuario Eliminado"), sembrada en el seed inicial.
    sp_eliminar_persona reasigna aquí la huella de personas borradas antes de hacer DELETE real
    de la persona/usuario original — el borrado es físico, no hay columna de tombstone.
  '''
}

Table contacto_emergencia {
  id integer [pk, increment]
  persona_id integer [not null, unique, ref: > persona.id]
  nombre varchar(150)
  telefono varchar(20)
  observaciones text
  actualizado_en timestamptz [not null, default: `now()`]

  Note: 'Opcional, 1:1 — si la persona no da estos datos, no hay fila. CHECK: al menos un campo no nulo.'
}

Table usuario {
  id integer [pk, increment]
  numero_documento varchar(20) [unique]
  correo varchar(150) [unique]
  password_hash text [not null]
  persona_id integer [ref: > persona.id]
  activo boolean [not null, default: true]
  fecha_creacion timestamptz [not null, default: `now()`]

  Note: '''
    id 999999999 = usuario sentinel, enlazado a la persona sentinel. activo = false, nunca hace login.
    CHECK: numero_documento o correo no puede ser null (al menos uno).
  '''
}

Table usuario_rol {
  id integer [pk, increment]
  usuario_id integer [not null, ref: > usuario.id]
  rol_id integer [not null, ref: > rol.id]
  asignado_en timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, rol_id) [unique, name: 'uq_usuario_rol']
  }

  Note: 'Multirol: un usuario puede tener varios roles (ej. ADMIN y PROFESOR a la vez). ON DELETE CASCADE desde usuario.'
}

Table horario {
  id integer [pk, increment]
  dia_semana integer [not null, note: 'ISO: 1 = lunes ... 7 = domingo']
  hora_inicio time [not null]
  hora_fin time [not null]
  activo boolean [not null, default: true]
}

Table horario_excepcion {
  id integer [pk, increment]
  horario_id integer [not null, ref: > horario.id]
  fecha date [not null]
  motivo text

  indexes {
    (horario_id, fecha) [unique, name: 'uq_horario_excepcion']
  }

  Note: 'El admin declara que un horario NO aplica cierta fecha. Se revisa antes de crear la sesión automática.'
}

Table sesion {
  id integer [pk, increment]
  horario_id integer [ref: > horario.id]
  fecha date [not null]
  hora_inicio timestamptz [not null]
  hora_fin timestamptz [note: 'NULL mientras la clase sigue en curso']
  profesor_usuario_id integer [ref: > usuario.id]
  cancelada boolean [not null, default: false]

  indexes {
    (horario_id, fecha) [unique, name: 'uq_sesion_horario_fecha']
  }

  Note: 'Máximo una sesión por horario por día (el índice solo aplica cuando horario_id no es null). Sesiones desacopladas (horario_id null) sí pueden coexistir el mismo día.'
}

Table llegada {
  id integer [pk, increment]
  persona_id integer [not null, ref: > persona.id]
  sesion_id integer [not null, ref: > sesion.id]
  hora_llegada timestamptz [not null, default: `now()`]
  metodo_checkin metodo_checkin_enum [not null]

  indexes {
    (persona_id, sesion_id) [unique, name: 'uq_llegada_persona_sesion']
  }

  Note: '''
    Única por (persona, sesion), no por (persona, fecha) — un mismo día puede tener más de una sesión válida.
    El índice único es parcial (WHERE persona_id <> 999999999): excluye al sentinel, que acumula llegadas
    de todas las personas eliminadas y por eso sí puede repetirse en una misma sesión.
  '''
}

Table asistencia {
  id integer [pk, increment]
  llegada_id integer [not null, unique, ref: > llegada.id]
  monto_cobrado numeric(10,2) [not null]
  marcado_por integer [not null, ref: > usuario.id]
  hora_marcado timestamptz [not null, default: `now()`]

  Note: 'Solo existe si el admin confirmó (el registro que hace un miembro es "llegada"). CHECK: monto_cobrado >= 0.'
}

Table metodo_pago {
  id integer [pk, increment]
  nombre varchar(50) [not null, unique]
  activo boolean [not null, default: true]
}

Table movimiento_cuenta {
  id integer [pk, increment]
  persona_id integer [not null, ref: > persona.id]
  llegada_id integer [ref: > llegada.id]
  monto_recibido numeric(10,2) [not null]
  monto_abonado numeric(10,2) [not null]
  metodo_pago_id integer [not null, ref: > metodo_pago.id]
  tipo_movimiento tipo_movimiento_enum [not null, default: 'ABONO']
  movimiento_original_id integer [ref: > movimiento_cuenta.id]
  vuelto_entregado boolean [not null, default: false]
  fecha_hora timestamptz [not null, default: `now()`]
  usuario_id integer [not null, ref: > usuario.id]
  nota text

  Note: 'CHECK: ABONO exige montos >= 0 y monto_abonado <= monto_recibido; REEMBOLSO exige monto_recibido = 0 y monto_abonado < 0.'
}

Table token_recuperacion {
  id integer [pk, increment]
  usuario_id integer [not null, ref: > usuario.id]
  token text [not null, unique]
  fecha_creacion timestamptz [not null, default: `now()`]
  fecha_expiracion timestamptz [not null]
  usado boolean [not null, default: false]

  Note: 'CHECK: fecha_expiracion > fecha_creacion.'
}

Table tarifa {
  id integer [pk, default: 1]
  monto numeric(10,2) [not null]
  actualizado_en timestamptz [not null, default: `now()`]
  actualizado_por integer [ref: > usuario.id]

  Note: 'Fila única (CHECK id = 1). CHECK: monto > 0.'
}

Table configuracion_cola {
  id integer [pk, default: 1]
  personas_por_turno integer [not null, default: 1]
  minutos_margen_ingreso integer [not null, default: 60, note: 'margen antes del inicio para poder hacer check-in']
  minutos_visibilidad_pagos integer [not null, default: 2, note: 'minutos que alguien aparece en la lista de "ya pagó"']
  actualizado_en timestamptz [not null, default: `now()`]
  actualizado_por integer [ref: > usuario.id]

  Note: 'Fila única (CHECK id = 1).'
}

Table historial_cambio {
  id integer [pk, increment]
  tabla_afectada tabla_auditable_enum [not null]
  registro_id integer [not null]
  campo varchar(50) [not null]
  valor_anterior text
  valor_nuevo text
  usuario_id integer [not null, ref: > usuario.id]
  fecha_hora timestamptz [not null, default: `now()`]

  Note: 'registro_id no tiene FK — puede apuntar a un registro ya borrado (ej. una persona eliminada vía sp_eliminar_persona).'
}
