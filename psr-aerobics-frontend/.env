VITE_API_URL=http://localhost:8080

# Sesión persistente (refresh token) — docs/notas-para-back.md §1. Apagada hasta que el backend
# publique POST /api/auth/refresh y POST /api/auth/logout; con esto en false el comportamiento
# es idéntico al de siempre (401 -> expulsa al login). Encender en true cuando esos endpoints
# respondan.
VITE_AUTH_REFRESH_ENABLED=false